<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Reading the custom character image the person picks. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- WebKit in the App Sandbox needs this to load the app's own pages
         (without it the memo window is blank; verified 2026-09-30).
         MemoPet itself makes no network requests. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>__TEAM_ID__.app.memopet.desktop</string>
    <key>com.apple.developer.team-identifier</key>
    <string>__TEAM_ID__</string>
</dict>
</plist>
